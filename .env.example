TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Bot Settings
# How often the main price check job runs (in seconds). Example: 300 for 5 minutes.
CHECK_INTERVAL=300
# Default check interval for chats if no custom interval is set (in seconds). Example: 3600 for 1 hour.
DEFAULT_CHAT_INTERVAL=3600

# Proxy Settings (Optional)
PROXY_ENABLED=False
VERIFY_SSL=True # Set to False if using proxies with self-signed certificates or having SSL issues

# Database Paths
DATABASE_PATH=data/trendyol_tracker.sqlite
BACKUP_DATABASE_PATH=data/database.sqlite # Path for the backup DB created by init_db.py (optional usage)
